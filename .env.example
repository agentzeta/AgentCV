PORT=3000
BASE_URL=http://localhost:3000
# Demo mode works without credentials. Live adapters fail closed.
OG_API_KEY=
# pick a model listed on the 0G Router models page
OG_MODEL=glm-5.2
OG_BASE_URL=https://router-api.0g.ai/v1
# optional: sent as X-0G-Provider-Trust-Mode only if set (not in the Router quickstart docs)
# OG_TRUST_MODE=
ARKIV_PRIVATE_KEY=
ARKIV_ACCESS_KEY=
# use the issuer your World Developer Portal app shows
WORLD_ISSUER=https://id.worldcoin.org
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
WORLD_REDIRECT_URI=http://localhost:3000/auth/world/callback
WORLD_CLIENT_AUTH=client_secret_basic
ADMIN_PUBLISH_TOKEN=

# On-chain evaluation attestations (optional). Deploy the registry with `npm run attest:deploy`,
# then attest a recorded run with `npm run attest -- <runId>`. Any EVM testnet works.
ATTEST_RPC_URL=https://sepolia.base.org
ATTEST_PRIVATE_KEY=
ATTEST_CHAIN_ID=84532
ATTEST_EXPLORER=https://sepolia.basescan.org
# ATTEST_CONTRACT=0x...   # set after deploy, used by `npm run attest`
# ATTEST_AGENT=0x...      # optional address to associate the evaluated agent with
