{
  "name": "agentcv-mumbai",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "arkiv:publish": "node scripts/publish-arkiv.js",
    "arkiv:read": "node scripts/read-arkiv.js",
    "eval:demo": "node scripts/eval-demo.js",
    "agent:example": "node scripts/example-agent.js",
    "eval:independent-demo": "node scripts/independent-demo.js",
    "demo:check": "node scripts/demo-check.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "install:frontend": "npm --prefix frontend install",
    "demo:react": "npm run build:frontend && npm start",
    "agent:baseline": "node scripts/baseline-agent.js",
    "setup": "npm install && npm --prefix frontend install",
    "start:deploy": "node scripts/serve-all.js",
    "build": "npm ci --prefix frontend && npm run build:frontend",
    "attest:deploy": "node scripts/deploy-attestation.mjs",
    "attest": "node scripts/attest-run.mjs"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "jose": "^6.1.0",
    "viem": "^2.37.0"
  },
  "license": "MIT",
  "devDependencies": {
    "solc": "0.8.28",
    "@ethereumjs/vm": "8.1.1",
    "@ethereumjs/tx": "5.4.0",
    "@ethereumjs/util": "9.1.0"
  }
}
